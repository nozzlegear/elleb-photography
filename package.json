{
  "name": "paway",
  "description": "For fancy people, Photographers and Travel Lovers",
  "demo": "https://godofredo.ninja",
  "version": "0.0.10",
  "type": "module",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "license": "GPLv3",
  "screenshots": {
    "desktop": "assets/images/screenshot-desktop.jpg",
    "mobile": "assets/images/screenshot-mobile.jpg"
  },
  "author": {
    "name": "GodoFredo",
    "email": "hello@godofredo.ninja",
    "url": "https://godofredo.ninja"
  },
  "gpm": {
    "type": "theme",
    "categories": [
      "Minimal",
      "Blog",
      "Magazine",
      "photographer",
      "travel"
    ]
  },
  "keywords": [
    "ghost",
    "theme",
    "photographer",
    "godofredo",
    "ghost-theme"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/godofredoninja/Paway.git"
  },
  "bugs": "https://github.com/godofredoninja/Paway/issues",
  "config": {
    "posts_per_page": 12,
    "image_sizes": {
      "xxs": {
        "width": 30
      },
      "xs": {
        "width": 100
      },
      "s": {
        "width": 300
      },
      "m": {
        "width": 600
      },
      "l": {
        "width": 1000
      },
      "xl": {
        "width": 2000
      }
    },
    "card_assets": {
      "exclude": [
        "bookmark",
        "blockquote"
      ]
    },
    "custom": {
      "instagram_url": {
        "type": "text"
      },
      "youtube_url": {
        "type": "text"
      },
      "pinterest_url": {
        "type": "text"
      },
      "tiktok_url": {
        "type": "text"
      },
      "stripe_publishable_key": {
        "type": "text",
        "description": "Stripe publishable API key."
      },
      "medusa_public_key": {
        "type": "text",
        "description": "MedusaJS publishable API key."
      },
      "medusa_base_url": {
        "type": "text",
        "description": "URL pointing to your MedusaJS installation."
      },
      "medusa_debug_mode": {
        "type": "boolean",
        "description": "Turns the Medusa integration's debug mode on or off.",
        "default": false
      },
      "publication_cover": {
        "type": "select",
        "options": [
          "None",
          "Featured"
        ],
        "default": "Featured",
        "group": "homepage"
      },
      "title_font": {
        "type": "select",
        "options": [
          "Modern sans-serif",
          "Playfair Display"
        ],
        "default": "Modern sans-serif"
      }
    }
  },
  "browserslist": [
    "defaults"
  ],
  "cssnano": {
    "preset": [
      "advanced",
      {
        "reduceIdents": false
      }
    ]
  },
  "scripts": {
    "build": "npm run build:vite && npm run build:zip",
    "build:vite": "vite build",
    "build:zip": "zip -x 'node_modules/*' -x '.git/*' -x '*.zip' -x 'vite*' -x 'svelte.config.*' -x 'tsconfig.*' -x 'quadlet/*' -x '.pkl-lsp/*' -x 'ghost-config.*' -x '.claude/*' -x '.idea/*' -x '.DS_Store' -x 'README.md' -x 'CLAUDE.md' -r ghost-elleb-photography-theme .",
    "prod": "cross-env NODE_ENV=production vite build",
    "dev": "cross-env NODE_ENV=development vite build --watch",
    "format": "biome format --write src/js/ src/css/pages",
    "validate": "svelte-check && tsc -p . --noEmit --skipLibCheck",
    "lint:js": "biome lint --write src/js/ && npm run validate",
    "lint:css": "biome lint --write src/css/pages",
    "lint": "npm run lint:js && npm run lint:css",
    "test": "npm lint && gscan .",
    "scan": "gscan ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/typography": "^0.5.4",
    "@types/node": "^20.0.0",
    "autoprefixer": "^10.4.8",
    "cross-env": "^7.0.3",
    "cssnano": "^5.1.12",
    "cssnano-preset-advanced": "^5.3.8",
    "gscan": "^4.48.0",
    "postcss": "^8.4.16",
    "postcss-discard-comments": "^5.1.2",
    "postcss-extend": "^1.0.5",
    "postcss-import": "^14.1.0",
    "postcss-nested": "^5.0.6",
    "precss": "^4.0.0",
    "svelte-check": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "@medusajs/js-sdk": "2.11",
    "@medusajs/types": "2.11",
    "lazysizes": "^5.3.2",
    "normalize.css": "^8.0.1",
    "tailwindcss": "^3.1.8"
  }
}
