/// Production Quadlet Kube unit file generator
module prodkube

import "quadlet.pkl"

// Configure your instance name here (should match prod.pkl instanceName)
local instanceName: String = "ellebphotos"

local kubeUnit: quadlet.KubeUnit = new {
  name = instanceName
  description = "Ghost Site - \(instanceName)"
  yamlFile = "prod.yaml"
  autoUpdate = true
}

output {
  text = kubeUnit.generate()
}
