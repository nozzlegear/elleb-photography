<template id="cart-item-template">
    <div class="cart-item" data-line-item-id="">
        <div class="cart-item-details">
            <h5 class="cart-item-variant" style="display: none;">Variant Title</h5>
            <h4 class="cart-item-title">Product Title</h4>
        </div>
        <div class="cart-item-image">
            <img src="" alt="" class="w-full h-full object-cover rounded" lazy="true">
        </div>
        <div class="cart-item-actions">
            <div class="quantity-controls" role="group" aria-label="Quantity">
                <button class="quantity-btn quantity-decrease" aria-label="Decrease quantity" data-action="decrease">-</button>
                <span class="quantity-display" aria-live="polite"></span>
                <button class="quantity-btn quantity-increase" aria-label="Increase quantity" data-action="increase">+</button>
            </div>
        </div>
        <div class="cart-item-remove">
            <button class="cart-item-remove-btn" type="button">Remove</button>
        </div>
        <div class="cart-item-price" aria-live="polite" aria-atomic="true">
            <span class="unit-price"></span>
        </div>
    </div>
</template>